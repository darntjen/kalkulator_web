@page "/projekte/{Id:int}"
@rendermode InteractiveServer
@inject KundenprojektDienst Dienst
@inject VertragswerkDienst Vertragswerk
@inject NavigationManager Navigation

<PageTitle>@(_projekt?.Kunde?.Firma ?? "Kundenprojekt") · Managed-Services-Kalkulator</PageTitle>

@if (_ladefehler is not null)
{
    <h1>Kundenprojekt</h1>
    <p class="meldung fehler">@_ladefehler</p>
}
else if (_projekt is null)
{
    <p>Lade …</p>
}
else
{
    <div class="ansicht-kopf">
        <div>
            <h1>@_projekt.Kunde!.Firma</h1>
            <p class="unterzeile">@_projekt.Titel · <StatusPille Status="_projekt.Status" /></p>
        </div>
        <a class="knopf zweit" href="projekte">Zur Übersicht</a>
    </div>

    @if (_meldung is not null)
    {
        <p class="meldung @(_meldungIstFehler ? "fehler" : "erfolg")">@_meldung</p>
    }

    <div class="spalten">
        <div class="stapel">
            @if (_projekt.Status == ProjektStatus.Gewonnen && _bereitschaft is { } b)
            {
                <section class="karte" id="vertragswerk">
                    <div class="karte-kopf">
                        <h2>Vertragswerk</h2>
                        @if (b.Angebot is not null)
                        {
                            <span class="unterzeile">aus Angebot @b.Angebot</span>
                        }
                    </div>
                    <div class="karte-inhalt stapel">
                        @if (b.Vorschau is { } vorschau)
                        {
                            <ol class="dokumentliste">
                                @foreach (var d in vorschau.Dokumente)
                                {
                                    <li>
                                        @d.Dokument.Bezeichnung
                                        @if (d.Fassung is { } f)
                                        {
                                            <span class="unterzeile"> · @d.Vorlage!.Code V@(f.Nummer)@(f.VersionLaut is { } v ? $" ({v})" : "")</span>
                                        }
                                        else
                                        {
                                            <span class="pille fassung-Abgelehnt">keine freigegebene Vorlage</span>
                                        }
                                    </li>
                                }
                            </ol>
                        }
                        @if (b.Sperrgrund is { } grund)
                        {
                            <p class="meldung info">@grund</p>
                        }
                        @if (b.Paperless && b.Hinweis is { } hinweis)
                        {
                            <p class="meldung info">@hinweis</p>
                        }
                        @if (b.DarfErzeugen && b.Sperrgrund is null && b.Unterzeichnerrollen is { Count: > 0 } rollen)
                        {
                            <fieldset class="stapel" disabled="@_erzeugt">
                                <legend class="unterzeile">Unterzeichner für Paperless</legend>
                                @foreach (var rolle in rollen)
                                {
                                    var eingabe = Unterzeichner(rolle);
                                    <div class="felder">
                                        <div class="feld">
                                            <label for="uz-name-@FeldId(rolle)">@rolle: Name *</label>
                                            <input id="uz-name-@FeldId(rolle)" type="text" @bind="eingabe.Name" autocomplete="off" />
                                        </div>
                                        <div class="feld">
                                            <label for="uz-mail-@FeldId(rolle)">@rolle: E-Mail *</label>
                                            <input id="uz-mail-@FeldId(rolle)" type="email" @bind="eingabe.EMail" autocomplete="off" />
                                        </div>
                                    </div>
                                }
                            </fieldset>
                        }
                        @if (b.DarfErzeugen)
                        {
                            <div class="aktionen">
                                <button type="button" class="knopf" disabled="@(b.Sperrgrund is not null || _erzeugt)" @onclick="VertragswerkErzeugenAsync">@(_erzeugt ? "Erzeuge Vertragswerk …" : "Vertragswerk erzeugen")</button>
                                <span class="unterzeile">Befüllt alle Dokumente, wandelt sie in PDF und fasst sie mit Deckblatt zu einer Gesamtdatei zusammen@(b.Paperless ? "; danach geht die Gesamtdatei mit den Unterschriftsfeldern an Paperless zur technischen Freigabe" : "").</span>
                            </div>
                        }
                    </div>
                    @if (_vertragswerke.Count > 0)
                    {
                        <div class="tab-rahmen">
                            <table class="liste">
                                <thead><tr><th>Ausfertigung</th><th>Erstellt</th><th>Dokumente</th>@if (MitPaperless) {<th>Paperless</th>}<th></th></tr></thead>
                                <tbody>
                                    @foreach (var w in _vertragswerke)
                                    {
                                        <tr>
                                            <td><strong>@w.Nummer</strong> · @w.Ausfertigung.</td>
                                            <td>@Texte.Zeitpunkt(w.ErstelltAm)<br /><span class="unterzeile">@w.ErstelltVon</span></td>
                                            <td>@w.Dokumente.Count</td>
                                            @if (MitPaperless)
                                            {
                                                <td>
                                                    @if (w.PaperlessDokumentId is { } pid)
                                                    {
                                                        <span class="pille st-Gewonnen">übergeben</span><br />
                                                        <span class="unterzeile">@Texte.Zeitpunkt(w.UebergebenAm!.Value) · Dokument @pid</span>
                                                    }
                                                    else if (w.UebergabeFehler is { } fehler)
                                                    {
                                                        <span class="pille st-Verloren">fehlgeschlagen</span><br />
                                                        <span class="unterzeile">@Texte.Zeitpunkt(w.UebergabeVersuchtAm!.Value): @fehler</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="unterzeile">nicht übergeben</span>
                                                    }
                                                </td>
                                            }
                                            <td>
                                                <div class="aktionen">
                                                    <a class="knopf zweit klein" href="vertragswerke/@w.Id/pdf" download>Gesamt-PDF</a>
                                                    <a class="knopf zweit klein" href="vertragswerke/@w.Id/zip" download>ZIP</a>
                                                    @if (_bereitschaft?.Paperless == true && _bereitschaft.DarfErzeugen && w.PaperlessDokumentId is null && w == _vertragswerke[0])
                                                    {
                                                        <button type="button" class="knopf zweit klein" disabled="@_erzeugt" @onclick="() => ErneutUebergebenAsync(w.Id)">@(w.UebergabeFehler is null ? "An Paperless übergeben" : "Erneut übergeben")</button>
                                                    }
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </section>
            }

            <KundensituationKarte ProjektId="Id" />

            <section class="karte">
                <div class="karte-kopf">
                    <h2>Kalkulationen</h2>
                    @if (_darfBearbeiten)
                    {
                        <form class="aktionen" @onsubmit="NeueKalkulationAsync">
                            <input type="text" aria-label="Titel der neuen Kalkulation" placeholder="Titel, z. B. Variante A" @bind="_neueKalkulation" />
                            <button class="knopf klein" type="submit">Neue Kalkulation</button>
                        </form>
                    }
                </div>
                @if (_projekt.Kalkulationen.Count == 0)
                {
                    <div class="karte-inhalt"><p class="unterzeile">Noch keine Kalkulation angelegt.</p></div>
                }
                else
                {
                    <div class="tab-rahmen">
                        <table class="liste">
                            <thead>
                                <tr>
                                    <th>Titel</th>
                                    <th>Forecast</th>
                                    <th class="num">Versionen</th>
                                    <th class="num">Sonderpositionen offen</th>
                                    <th>Angelegt</th>
                                    @if (_darfBearbeiten)
                                    {
                                        <th></th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var k in _projekt.Kalkulationen.OrderBy(k => k.ErstelltAm).ThenBy(k => k.Id))
                                {
                                    <tr>
                                        <td><a href="kalkulationen/@k.Id">@k.Titel</a></td>
                                        <td>@if (k.FuerForecast) { <span class="markiert" title="Diese Variante zählt im Forecast">★ zählt</span> }</td>
                                        <td class="num">@(k.Versionen.Count == 0 ? "–" : string.Join(", ", k.Versionen.OrderBy(v => v.Nummer).Select(v => v.Bezeichnung)))</td>
                                        <td class="num">@k.Sonderpositionen.Count(s => s.Status != Freigabestatus.Freigegeben)</td>
                                        <td>@Texte.Zeitpunkt(k.ErstelltAm)<br /><span class="unterzeile">@k.ErstelltVon</span></td>
                                        @if (_darfBearbeiten)
                                        {
                                            <td>
                                                <div class="aktionen">
                                                    <button class="knopf zweit klein" type="button" @onclick="() => DuplizierenAsync(k)">Duplizieren</button>
                                                    @if (!k.FuerForecast)
                                                    {
                                                        <button class="knopf zweit klein" type="button" @onclick="() => FuerForecastAsync(k)">Für Forecast</button>
                                                    }
                                                </div>
                                            </td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </section>

            <UnterlagenKarte ProjektId="Id" />

            <section class="karte">
                <div class="karte-kopf"><h2>Statusverlauf</h2></div>
                <div class="karte-inhalt">
                    <ol class="verlauf">
                        @foreach (var e in _projekt.StatusEreignisse.OrderBy(e => e.Zeitpunkt).ThenBy(e => e.Id))
                        {
                            <li>
                                <strong>@Texte.Status(e.Neu)</strong> · @Texte.Zeitpunkt(e.Zeitpunkt) · @e.Benutzer
                                @if (e.Verlustgrund is { } grund)
                                {
                                    <span> · Grund: @Texte.Verlustgrund(grund)</span>
                                }
                                @if (e.Kommentar is not null)
                                {
                                    <br /><span class="unterzeile">„@e.Kommentar“</span>
                                }
                            </li>
                        }
                    </ol>
                </div>
            </section>
        </div>

        <div class="stapel">
            @if (_angeboteZurAnnahme.FirstOrDefault(a => a.Id == _projekt.AngenommenesAngebotId) is { } angenommen)
            {
                <section class="karte">
                    <div class="karte-kopf"><h2>Angenommenes Angebot</h2></div>
                    <div class="karte-inhalt stapel">
                        <dl class="daten">
                            <dt>Angebot</dt>
                            <dd>@angenommen.Nummer V@(angenommen.Version)</dd>
                            <dt>Kalkulation</dt>
                            <dd>@angenommen.Kalkulation</dd>
                            <dt>Monatlich</dt>
                            <dd>@Texte.Euro(angenommen.SummeMonatlich) netto</dd>
                        </dl>
                        <div class="aktionen"><a class="knopf zweit klein" href="angebote/@angenommen.Id/datei" download>Word herunterladen</a></div>
                    </div>
                </section>
            }

            <section class="karte">
                <div class="karte-kopf"><h2>Kunde</h2></div>
                <div class="karte-inhalt">
                    <dl class="daten">
                        <dt>Anschrift</dt>
                        <dd>@(Anschrift ?? "–")</dd>
                        <dt>Ansprechpartner</dt>
                        <dd>@(_projekt.Kunde.Ansprechpartner ?? "–")</dd>
                        <dt>Navision-Nr.</dt>
                        <dd>@(_projekt.Kunde.NavisionKundennummer ?? "–")</dd>
                        <dt>Kundenart</dt>
                        <dd>@(_projekt.Bestandskunde ? "Bestandskunde" : "Neukunde")</dd>
                        <dt>Verantwortlich</dt>
                        <dd>@_projekt.Verantwortlich</dd>
                    </dl>
                </div>
            </section>

            <AnalyseAngeboteKarte ProjektId="Id" />

            <section class="karte">
                <div class="karte-kopf"><h2>Forecast</h2></div>
                <div class="karte-inhalt">
                    @if (_darfBearbeiten)
                    {
                        <form class="stapel" @onsubmit="ForecastAsync">
                            <div class="feld"><label for="wahrscheinlichkeit">Abschlusswahrscheinlichkeit (%)</label><input id="wahrscheinlichkeit" type="number" min="0" max="100" step="5" @bind="_wahrscheinlichkeit" /></div>
                            <div class="feld"><label for="monat">Erwarteter Abschlussmonat</label><input id="monat" type="month" @bind="_monat" @bind:format="yyyy-MM" /></div>
                            <div class="aktionen"><button class="knopf klein" type="submit">Forecast speichern</button></div>
                        </form>
                    }
                    else
                    {
                        <dl class="daten">
                            <dt>Wahrscheinlichkeit</dt>
                            <dd>@(_projekt.Wahrscheinlichkeit is { } w ? $"{w} %" : "–")</dd>
                            <dt>Abschluss</dt>
                            <dd>@Texte.Monat(_projekt.ErwarteterAbschlussmonat)</dd>
                        </dl>
                    }
                </div>
            </section>

            @if (_darfBearbeiten && Moegliche.Count > 0)
            {
                <section class="karte">
                    <div class="karte-kopf"><h2>Status ändern</h2></div>
                    <div class="karte-inhalt">
                        <form class="stapel" @onsubmit="StatusAsync">
                            <div class="feld">
                                <label for="status">Neuer Status</label>
                                <select id="status" @bind="_neuerStatus">
                                    <option value="">Bitte wählen</option>
                                    @foreach (var s in Moegliche)
                                    {
                                        <option value="@s">@Texte.Status(s)</option>
                                    }
                                </select>
                            </div>
                            @if (_neuerStatus == ProjektStatus.Verloren)
                            {
                                <div class="feld">
                                    <label for="grund">Verlustgrund *</label>
                                    <select id="grund" @bind="_verlustgrund">
                                        <option value="">Bitte wählen</option>
                                        @foreach (var g in Enum.GetValues<Verlustgrund>())
                                        {
                                            <option value="@g">@Texte.Verlustgrund(g)</option>
                                        }
                                    </select>
                                </div>
                            }
                            @if (_neuerStatus == ProjektStatus.Gewonnen)
                            {
                                <div class="feld">
                                    <label for="angebot">Angenommenes Angebot *</label>
                                    @if (_angeboteZurAnnahme.Count == 0)
                                    {
                                        <p class="unterzeile">Es gibt noch kein als versendet markiertes Angebot. Bitte das Angebot in der Kalkulation erst als versendet markieren.</p>
                                    }
                                    else
                                    {
                                        <select id="angebot" @bind="_angenommenesAngebot">
                                            <option value="">Bitte wählen</option>
                                            @foreach (var a in _angeboteZurAnnahme)
                                            {
                                                <option value="@a.Id">@a.Text · @Texte.Euro(a.SummeMonatlich) mtl.@(a.VersendetAm is { } v ? $" · versendet {v:dd.MM.yyyy}" : "")</option>
                                            }
                                        </select>
                                    }
                                </div>
                            }
                            <div class="feld"><label for="kommentar">Kommentar</label><textarea id="kommentar" rows="2" @bind="_kommentar"></textarea></div>
                            <div class="aktionen"><button class="knopf klein" type="submit" disabled="@(_neuerStatus is null || (_neuerStatus == ProjektStatus.Gewonnen && _angenommenesAngebot is null))">Status setzen</button></div>
                        </form>
                    </div>
                </section>
            }
        </div>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }

    private Kundenprojekt? _projekt;
    private bool _darfBearbeiten;
    private string? _ladefehler, _meldung, _neueKalkulation, _kommentar;
    private bool _meldungIstFehler;
    private int? _wahrscheinlichkeit;
    private DateTime? _monat;
    private ProjektStatus? _neuerStatus;
    private Verlustgrund? _verlustgrund;
    private int? _angenommenesAngebot;
    private IReadOnlyList<AngebotsAuswahl> _angeboteZurAnnahme = [];
    private VertragswerkBereitschaft? _bereitschaft;
    private IReadOnlyList<VertragswerkZeile> _vertragswerke = [];
    private bool _erzeugt;
    private readonly Dictionary<string, UnterzeichnerEingabe> _unterzeichner = new(StringComparer.Ordinal);

    private sealed class UnterzeichnerEingabe
    {
        public string Name { get; set; } = "";
        public string EMail { get; set; } = "";
    }

    /// <summary>Paperless-Spalte, sobald die Übergabe eingerichtet ist oder schon einmal versucht wurde.</summary>
    private bool MitPaperless => _bereitschaft?.Paperless == true || _vertragswerke.Any(w => w.UebergabeVersuchtAm is not null);

    /// <summary>Eingabe je Rolle; für den Kunden mit dem Ansprechpartner vorbelegt.</summary>
    private UnterzeichnerEingabe Unterzeichner(string rolle)
    {
        if (!_unterzeichner.TryGetValue(rolle, out var eingabe))
        {
            eingabe = new UnterzeichnerEingabe
            {
                Name = string.Equals(rolle, "Kunde", StringComparison.OrdinalIgnoreCase) ? _projekt?.Kunde?.Ansprechpartner ?? "" : "",
            };
            _unterzeichner[rolle] = eingabe;
        }

        return eingabe;
    }

    private static string FeldId(string rolle) => Convert.ToHexString(System.Text.Encoding.UTF8.GetBytes(rolle));

    private IReadOnlyList<ProjektStatus> Moegliche =>
        _projekt is null ? [] : [.. Enum.GetValues<ProjektStatus>().Where(_projekt.KannWechselnZu)];

    private string? Anschrift => _projekt?.Kunde is { } k && (k.Strasse ?? k.Ort) is not null
        ? string.Join(", ", new[] { k.Strasse, $"{k.Postleitzahl} {k.Ort}".Trim() }.Where(t => !string.IsNullOrWhiteSpace(t)))
        : null;

    protected override Task OnParametersSetAsync() => LadeAsync();

    private async Task LadeAsync()
    {
        try
        {
            _projekt = await Dienst.LadeAsync(Id);
            if (_projekt is null)
            {
                _ladefehler = "Dieses Kundenprojekt gibt es nicht.";
                return;
            }

            _darfBearbeiten = Dienst.Recht.DarfBearbeiten(_projekt);
            _angeboteZurAnnahme = await Dienst.AngeboteZurAnnahmeAsync(Id);
            if (_projekt.Status == ProjektStatus.Gewonnen)
            {
                _bereitschaft = await Vertragswerk.BereitschaftAsync(Id);
                _vertragswerke = await Vertragswerk.ListeAsync(Id);
            }
            _wahrscheinlichkeit = _projekt.Wahrscheinlichkeit;
            _monat = _projekt.ErwarteterAbschlussmonat?.ToDateTime(TimeOnly.MinValue);
        }
        catch (KeinZugriffException e)
        {
            _ladefehler = e.Message;
        }
    }

    private Task NeueKalkulationAsync() => AusfuehrenAsync(async () =>
    {
        var id = await Dienst.NeueKalkulationAsync(Id, string.IsNullOrWhiteSpace(_neueKalkulation) ? $"Variante {(char)('A' + _projekt!.Kalkulationen.Count)}" : _neueKalkulation);
        Navigation.NavigateTo($"kalkulationen/{id}");
    }, null);

    private Task DuplizierenAsync(Kalkulation k) =>
        AusfuehrenAsync(() => Dienst.DuplizierenAsync(k.Id, $"{k.Titel} (Kopie)"), $"„{k.Titel}“ wurde dupliziert. Sonderpositionen brauchen in der Kopie eine neue Freigabe.");

    private Task FuerForecastAsync(Kalkulation k) =>
        AusfuehrenAsync(() => Dienst.FuerForecastMarkierenAsync(k.Id), $"„{k.Titel}“ zählt jetzt im Forecast.");

    private Task ForecastAsync() =>
        AusfuehrenAsync(() => Dienst.SetzeForecastAsync(Id, _wahrscheinlichkeit, _monat is { } m ? DateOnly.FromDateTime(m) : null), "Forecast gespeichert.");

    private Task StatusAsync() => AusfuehrenAsync(async () =>
    {
        await Dienst.SetzeStatusAsync(Id, _neuerStatus!.Value, _kommentar, _neuerStatus == ProjektStatus.Verloren ? _verlustgrund : null,
            _neuerStatus == ProjektStatus.Gewonnen ? _angenommenesAngebot : null);
        _neuerStatus = null;
        _verlustgrund = null;
        _angenommenesAngebot = null;
        _kommentar = null;
    }, "Status gesetzt.");

    private async Task VertragswerkErzeugenAsync()
    {
        _erzeugt = true;
        try
        {
            var personen = _bereitschaft?.Unterzeichnerrollen?.Select(r => new Unterzeichner(r, Unterzeichner(r).Name, Unterzeichner(r).EMail)).ToList();
            await AusfuehrenAsync(async () =>
            {
                var werkId = await Vertragswerk.ErzeugenAsync(Id, personen);
                return await Uebergabemeldung(werkId, neu: true);
            });
        }
        finally
        {
            _erzeugt = false;
        }
    }

    private async Task ErneutUebergebenAsync(int werkId)
    {
        _erzeugt = true;
        try
        {
            await AusfuehrenAsync(async () =>
            {
                await Vertragswerk.ErneutUebergebenAsync(werkId);
                return await Uebergabemeldung(werkId, neu: false);
            });
        }
        finally
        {
            _erzeugt = false;
        }
    }

    /// <summary>Meldung nach dem Erzeugen bzw. Übergeben; eine fehlgeschlagene Übergabe erscheint als Fehler.</summary>
    private async Task<(string? Text, bool Fehler)> Uebergabemeldung(int werkId, bool neu)
    {
        var werk = (await Vertragswerk.ListeAsync(Id)).FirstOrDefault(w => w.Id == werkId);
        return werk switch
        {
            { PaperlessDokumentId: { } pid } => ($"Vertragswerk {(neu ? "erzeugt und " : "")}an Paperless übergeben (Dokument {pid}). Technische Freigabe und Versand an den Kunden laufen dort.", false),
            { UebergabeFehler: { } fehler } when neu => ($"Vertragswerk erzeugt und gespeichert, aber die Übergabe an Paperless ist fehlgeschlagen: {fehler} Bitte später „Erneut übergeben“.", true),
            { UebergabeFehler: { } fehler } => ($"Die Übergabe an Paperless ist erneut fehlgeschlagen: {fehler}", true),
            _ => ("Vertragswerk erzeugt. Gesamt-PDF und ZIP stehen zum Herunterladen bereit.", false),
        };
    }

    /// <summary>Führt eine Aktion aus, zeigt Erfolg oder die fachliche Fehlermeldung und lädt das Projekt neu.</summary>
    private Task AusfuehrenAsync(Func<Task> aktion, string? erfolg) => AusfuehrenAsync(async () =>
    {
        await aktion();
        return (erfolg, false);
    });

    private async Task AusfuehrenAsync(Func<Task<(string? Text, bool Fehler)>> aktion)
    {
        try
        {
            (_meldung, _meldungIstFehler) = await aktion();
        }
        catch (Exception e) when (e is ArgumentException or InvalidOperationException or KeyNotFoundException or KeinZugriffException or Microsoft.EntityFrameworkCore.DbUpdateConcurrencyException)
        {
            (_meldung, _meldungIstFehler) = (e is Microsoft.EntityFrameworkCore.DbUpdateConcurrencyException
                ? "Jemand anderes hat das Projekt gerade geändert. Die Ansicht ist jetzt aktuell, bitte noch einmal versuchen."
                : e.Message, true);
        }

        await LadeAsync();
    }
}

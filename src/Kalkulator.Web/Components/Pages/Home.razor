@page "/"
@rendermode InteractiveServer
@inject Kalkulator.Infrastructure.Persistenz.IBenutzerKontext Benutzer
@inject VertragswerkDienst Vertragswerk

<PageTitle>Start · Managed-Services-Kalkulator</PageTitle>

<h1>Managed-Services-Kalkulator</h1>

<p>Managed Services kalkulieren, Angebote erstellen und Vertragsunterlagen zusammenstellen.</p>

@if (_meldung is not null)
{
    <p class="meldung @(_meldungIstFehler ? "fehler" : "erfolg")">@_meldung</p>
}

@if (_offen is { Count: > 0 } offen)
{
    <section class="karte" id="offene-freigaben">
        <div class="karte-kopf">
            <h2>Offene Freigaben <span class="pille">@offen.Count</span></h2>
            <span class="unterzeile">Vertragswerke, die auf deine Prüfung warten</span>
        </div>
        <ul class="karte-inhalt freigabeliste">
            @foreach (var o in offen)
            {
                <li class="stapel">
                    <div>
                        <a href="projekte/@o.ProjektId#vertragswerk"><strong>@o.Firma</strong></a>
                        <span class="unterzeile">@o.Projekt · Vertrag @o.Nummer, @(o.Ausfertigung). Ausfertigung vom @Texte.Zeitpunkt(o.ErstelltAm)</span>
                    </div>
                    <div class="aktionen">
                        <a class="knopf zweit klein" href="vertragswerke/@o.VertragswerkId/ansicht" target="_blank" rel="noopener">Vertrag ansehen</a>
                        @foreach (var art in o.Offen)
                        {
                            <button type="button" class="knopf klein" disabled="@_beschaeftigt" @onclick="() => FreigebenAsync(o.VertragswerkId, art)">@Texte.Vertragsfreigabe(art) freigeben</button>
                            <button type="button" class="knopf zweit klein" disabled="@_beschaeftigt" @onclick="() => { _ablehnung = (o.VertragswerkId, art); _begruendung = null; }">@Texte.Vertragsfreigabe(art) ablehnen</button>
                        }
                    </div>
                    @if (_ablehnung is { } ab && ab.Werk == o.VertragswerkId)
                    {
                        <div class="stapel">
                            <label for="begruendung-@o.VertragswerkId">Begründung der Ablehnung (@Texte.Vertragsfreigabe(ab.Art)) *</label>
                            <textarea id="begruendung-@o.VertragswerkId" rows="2" maxlength="1000" @bind="_begruendung" @bind:event="oninput"></textarea>
                            <div class="aktionen">
                                <button type="button" class="knopf gefahr klein" disabled="@(_beschaeftigt || string.IsNullOrWhiteSpace(_begruendung))" @onclick="AblehnenAsync">Ablehnung senden</button>
                                <button type="button" class="knopf zweit klein" @onclick="() => _ablehnung = null">Abbrechen</button>
                            </div>
                        </div>
                    }
                </li>
            }
        </ul>
    </section>
}
else if (new Berechtigung(Benutzer).DarfVertraegeFreigeben)
{
    <p class="meldung info">Keine Vertragswerke warten auf deine Freigabe.</p>
}

<div class="kacheln">
    <a class="kachel" href="projekte">
        <h2>Kundenprojekte</h2>
        <p>Kundenprojekte und Kalkulationen anlegen, Projektstatus und Forecast pflegen.</p>
    </a>
    @if (new Berechtigung(Benutzer).DarfKatalogSehen)
    {
        <a class="kachel" href="katalog">
            <h2>Katalog</h2>
            <p>Services, Bundles, Preislisten und Parameter pflegen.</p>
        </a>
    }
    <a class="kachel" href="statistik">
        <h2>Statistik</h2>
        <p>Kennzahlen zu Kalkulationen, Angeboten und Abschlüssen.</p>
    </a>
</div>

@code {
    private IReadOnlyList<OffeneVertragsfreigabe>? _offen;
    private (int Werk, VertragsfreigabeArt Art)? _ablehnung;
    private string? _begruendung, _meldung;
    private bool _meldungIstFehler, _beschaeftigt;

    protected override async Task OnInitializedAsync() => _offen = await Vertragswerk.OffeneFreigabenAsync();

    /// <summary>Schnellfreigabe direkt aus der Liste; dieselben Regeln wie in der Projektansicht.</summary>
    private Task FreigebenAsync(int werkId, VertragsfreigabeArt art) => PruefenAsync(werkId, art, true, null);

    private Task AblehnenAsync() =>
        _ablehnung is { } ab ? PruefenAsync(ab.Werk, ab.Art, false, _begruendung) : Task.CompletedTask;

    private async Task PruefenAsync(int werkId, VertragsfreigabeArt art, bool erteilt, string? begruendung)
    {
        var eintrag = _offen?.FirstOrDefault(o => o.VertragswerkId == werkId);
        _beschaeftigt = true;
        try
        {
            await Vertragswerk.FreigebenAsync(werkId, art, erteilt, begruendung);
            _ablehnung = null;
            _begruendung = null;
            var werk = eintrag is null ? null : (await Vertragswerk.ListeAsync(eintrag.ProjektId)).FirstOrDefault(w => w.Id == werkId);
            var wer = $"{Texte.Vertragsfreigabe(art)} für {eintrag?.Firma} ({eintrag?.Nummer})";
            (_meldung, _meldungIstFehler) = (erteilt, werk) switch
            {
                (false, _) => ($"{wer} abgelehnt. Der Vertrieb korrigiert und erzeugt das Vertragswerk neu.", false),
                (true, { PaperlessDokumentId: { } pid }) => ($"{wer} freigegeben. Alle Freigaben liegen vor; das Vertragswerk ist an Paperless übergeben (Dokument {pid}).", false),
                (true, { UebergabeFehler: { } fehler }) => ($"{wer} freigegeben, aber die Übergabe an Paperless ist fehlgeschlagen: {fehler}", true),
                (true, { IstFreigegeben: true }) => ($"{wer} freigegeben. Alle Freigaben liegen vor.", false),
                (true, { } w) => ($"{wer} freigegeben. {Texte.FehlendeFreigaben(w.Fehlend)}", false),
                _ => ($"{wer} freigegeben.", false),
            };
        }
        catch (Exception e) when (e is InvalidOperationException or ArgumentException or KeyNotFoundException)
        {
            (_meldung, _meldungIstFehler) = (e.Message, true);
        }
        finally
        {
            _beschaeftigt = false;
            _offen = await Vertragswerk.OffeneFreigabenAsync();
        }
    }
}

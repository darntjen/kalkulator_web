root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,props,csproj,slnx,xml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.cs]
# Namespaces
csharp_style_namespace_declarations = file_scoped:warning
dotnet_sort_system_directives_first = true

# var
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = true:suggestion

# Ausdrücke
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_prefer_braces = true:warning
dotnet_style_readonly_field = true:warning

# Benennung: Konstanten und static readonly in PascalCase (Regeln mit Modifizierern haben Vorrang)
dotnet_naming_rule.konstanten_pascal.symbols = konstanten
dotnet_naming_rule.konstanten_pascal.style = pascal
dotnet_naming_rule.konstanten_pascal.severity = warning
dotnet_naming_symbols.konstanten.applicable_kinds = field
dotnet_naming_symbols.konstanten.required_modifiers = const
dotnet_naming_rule.statisch_readonly_pascal.symbols = statisch_readonly
dotnet_naming_rule.statisch_readonly_pascal.style = pascal
dotnet_naming_rule.statisch_readonly_pascal.severity = warning
dotnet_naming_symbols.statisch_readonly.applicable_kinds = field
dotnet_naming_symbols.statisch_readonly.required_modifiers = static, readonly
dotnet_naming_style.pascal.capitalization = pascal_case

# Benennung: private Felder mit _camelCase
dotnet_naming_rule.private_fields_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_underscore.style = underscore_camel
dotnet_naming_rule.private_fields_underscore.severity = warning
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_style.underscore_camel.capitalization = camel_case
dotnet_naming_style.underscore_camel.required_prefix = _

# Unnötige usings
dotnet_diagnostic.IDE0005.severity = warning

# Von „dotnet ef“ erzeugte Migrationen: generierter Code, keine Stilprüfung
[src/Kalkulator.Infrastructure/Persistenz/Migrationen/*.cs]
generated_code = true
